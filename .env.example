# Notion Knowledge Base (used by /xmarks skill)
# Get the data source UUID from `notion-fetch` on the database, look at the <data-source url="collection://..."> tag.
NOTION_KB_DATA_SOURCE_ID=

# X (Twitter) OAuth 2.0 PKCE
# Developer Portal: https://developer.x.com/
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/callback

# xAI (Grok) — used by `bun run article` to fetch X article body via x_search tool
# Get a key at https://console.x.ai/
# Optional: when unset, `bun run article` errors out and the skill falls back to title+previewText only.
XAI_API_KEY=
XAI_MODEL=grok-4-fast-non-reasoning

# Secret backend: "local" (default) or "gsm"
SECRET_BACKEND=local

# Local secret store (used when SECRET_BACKEND=local)
# Defaults to ${XDG_CONFIG_HOME:-~/.config}/xmarks
XMARKS_HOME=

# Google Secret Manager (used when SECRET_BACKEND=gsm)
GOOGLE_CLOUD_PROJECT=
# Optional override prefix for secret resource names. Default: "xmarks"
GSM_SECRET_PREFIX=xmarks

# Service account credentials for GSM access. Use ONE of:
#   GOOGLE_APPLICATION_CREDENTIALS=/abs/path/to/sa.json   (local dev)
#   GCP_SA_KEY_JSON=<full JSON of SA key>                 (cloud envs like Routines)
GOOGLE_APPLICATION_CREDENTIALS=
GCP_SA_KEY_JSON=
